{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ingest-page 输出契约",
  "type": "object",
  "required": ["pageSummary", "cards", "skipped"],
  "additionalProperties": false,
  "properties": {
    "pageSummary": {
      "type": "object",
      "required": ["totalQuestions", "markedWrong"],
      "additionalProperties": false,
      "properties": {
        "totalQuestions": { "type": "integer", "minimum": 1 },
        "markedWrong": { "type": "integer", "minimum": 0 },
        "unmarked": { "type": "integer", "minimum": 0 },
        "note": { "type": "string", "maxLength": 300 }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 0,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "subject", "title", "questionText", "studentAnswer",
          "answerSource", "causeCode", "confidence", "sourceImageSha256", "teacherAnswer"
        ],
        "additionalProperties": false,
        "properties": {
          "subject": { "type": "string", "enum": ["数学", "语文", "英语", "物理", "化学", "生物", "历史", "地理", "政治"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 24 },
          "source": { "type": "string", "maxLength": 200 },
          "sourceDate": { "type": "string", "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$" },
          "questionText": { "type": "string", "minLength": 1 },
          "studentAnswer": { "type": "string", "minLength": 1 },
          "answer": { "type": "string" },
          "answerSource": {
            "type": "string",
            "enum": ["独立判卷", "官方答案", "红笔订正+官方答案页核对", "未能确认"],
            "description": "答案的**唯一**合法来源。⚠ **没有「老师定案」** —— 卷面红字绝大部分不是老师批的（孩子自己批改/订正、同学互批、家长帮批），**红字只能作普通参考，不能作定案标准**（即使确认是老师写的也不行）。答案只能来自：你自己独立解出来（独立判卷），或官方答案页/公开题库（官方答案）。"
          },
          "answerSourceNote": { "type": "string", "maxLength": 500 },
          "teacherAnswer": { "type": "string", "maxLength": 500, "description": "照片上**红色批注**的原文，原样转录；没有红色批注就填空串。每张卡必填（入库器校验，不分答案来源）。⚠ 它是**参考材料**，不是答案依据 —— 卷面红字绝大部分不是老师批的。程序据此拦『答案悄悄覆盖红字批注』，冲突卡须异议裁决后才能组卷。" },
          "inkAttribution": {
            "type": "string",
            "enum": ["老师", "孩子", "家长", "同学", "未确认"],
            "description": "**红字是谁写的**（teacherAnswer 非空时必填）。作用是**如实记录归属**供人核对，**不参与答案权威性判定** —— 红字一律不作定案标准。判据：笔迹/色差（R−G）比对、与孩子黑笔的差异、笔压；判不出就写「未确认」，不许猜成「老师」。"
          },
          "causeCode": {
            "type": "string",
            "enum": ["K1", "K2", "K3", "K4", "K5", "K6", "K7", "L1", "L2", "L3", "L4", "S1", "S2", "S3", "S4", "S5"]
          },
          "causeNote": { "type": "string", "minLength": 1, "maxLength": 300 },
          "kpoints": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 5 },
          "difficulty": { "type": "string", "enum": ["易", "中", "难", ""] },
          "hasFigure": { "type": "boolean" },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "sourceImageSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "notes": { "type": "string", "maxLength": 500 },
          "bbox": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": { "type": "number", "minimum": 0, "maximum": 1 },
            "description": "这道题在整页原图上的位置：归一化 0~1 的 [x, y, w, h]（左上角 x,y 与宽高）。"
          },
          "figBbox": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": { "type": "number", "minimum": 0, "maximum": 1 },
            "description": "这道题的**插图**在整页原图上的位置：归一化 0~1 的 [x, y, w, h]。hasFigure=true 时必填 —— 程序据此裁出「题图.jpg」（只含图，不含孩子的作答与红笔）。"
          },
          "studentAnswerHtml": { "type": "string", "maxLength": 4000 },
          "answerMode": { "type": "string", "enum": ["blank", "figure", "zone", "none"] },
          "answerSlots": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "skipped": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["what", "reason"],
        "additionalProperties": false,
        "properties": {
          "what": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
