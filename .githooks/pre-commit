#!/bin/sh
# 拾光小册 · pre-commit 门禁（真源：.githooks/pre-commit，随仓库版本化）
#
# 2026-10-29 从 .git\hooks\pre-commit 迁入 .githooks\ 并纳管：
#   .git\hooks\ 不进版本库 ⇒ 干净克隆里门禁根本不存在（L-02 根因）。
#   仓库根推导随之改为 `git rev-parse --show-toplevel`：原来的 "$0/../.."
#   是 .git/hooks 的位置假设，搬到 .githooks/ 后会多退一级、cd 到仓库外。
#   安装方式：powershell -NoProfile -File scripts\install-hooks.ps1
#
# 2026-10-25 用户定规：「我需要你以后只能走正确链路：dev 改 → dev 测 →
# build-release.ps1 打包 → deploy.ps1 部署（自动写部署记录）。如何设置，
# 确保以后只能走这条路？」
#
# 三道机械检查（任何一道红就不许提交）：
#   1) tools\lint.mjs           —— 语法/死代码/硬编码路径
#   2) tests\run.mjs fixture    —— 零依赖自检（不需要 exe、不需要真实题库影像）
#   3) scripts\verify-deploy.mjs —— 运行区是否被人绕过 deploy.ps1 直接改过
#
# 为什么第 3 条要放在提交时：
#   绕过部署改运行区的人，通常会在几分钟内顺手提交。把"运行区漂移"在**提交关口**
#   抓出来，是最省事的阻断点 —— 提交后才发现，就得回溯是谁、改了什么、要不要重发。
#
# 逃生阀（仅在确有必要时人工执行，务必留痕）：
#   git commit --no-verify      # 跳过全部检查（会被 git 记录为跳过，慎用）
set -e

REPO="$(git rev-parse --show-toplevel)"
cd "$REPO"

# ── 1) lint ──
if [ -f tools/lint.mjs ]; then
  echo "[pre-commit] ① lint ..."
  if ! node tools/lint.mjs > /tmp/gn-lint.log 2>&1; then
    echo "  ✖ tools/lint.mjs 未通过（详情：/tmp/gn-lint.log 末尾）"
    tail -n 20 /tmp/gn-lint.log
    exit 1
  fi
  echo "  ✔ lint 通过"
fi

# ── 2) 零依赖自检 ──
if [ -f tests/run.mjs ]; then
  echo "[pre-commit] ② fixture 自检 ..."
  if ! node tests/run.mjs fixture > /tmp/gn-fixture.log 2>&1; then
    echo "  ✖ tests/run.mjs fixture 未通过（详情：/tmp/gn-fixture.log 末尾）"
    tail -n 25 /tmp/gn-fixture.log
    exit 1
  fi
  echo "  ✔ fixture 自检通过"
fi

# ── 3) 运行区漂移 ──
# ★ 2026-10-31 E03 整改：退出码不再"所有非 0 一律同一种处理"。
#   改前：verify-deploy 的 exit 2 同时表示「没有运行区」与「清单解析失败/形状不对」，
#   本钩子把**所有** exit 2 都当"这台机器没有运行区"放行 ⇒ **清单损坏 = fail-open**
#   （实测：把 _deploy-manifest.json 写坏 → rc=2 → 本钩子返回 0，允许提交；对照 rc=1 才拦）。
#   现在退出码定义在 scripts\verify-deploy.mjs 头部注释（唯一真源），本处只做分支：
#     0 一致 → 通过
#     3 本机没有运行区 → **唯一**可豁免（新克隆/换机/CI 的预期状态；无法评估 ≠ 有漂移）
#     其它(1 漂移 / 2 用法错误 / 4 清单损坏 / 5 尚无清单) → 一律阻断（fail-closed）
#   为什么 4(清单损坏) 必须拦：损坏不是"没有"，是"基线读不懂"——放行等于把"删掉/写坏清单"
#   变成过门禁的捷径。同理 5(尚无清单) 也不再放行：无法证明 = 不通过，建基线走一次正规部署。
#   消费侧判据与 tests\run.mjs 共用一份（tests\_测试环境.cjs 的 classifyVerifyDeploy），
#   两份 if/else 必然漂移（本仓 L-286），所以这里只保留与它逐条对齐的最小实现。
if [ -f scripts/verify-deploy.mjs ]; then
  echo "[pre-commit] ③ 运行区部署一致性 ..."
  set +e
  node scripts/verify-deploy.mjs --quiet
  rc=$?
  set -e
  case "$rc" in
    0) echo "  ✔ 运行区与部署清单一致" ;;
    3)
      # 唯一豁免：本机根本没有运行区（默认 <仓库上一级>\GlimmerNote 不存在）。
      # 干净克隆里这是预期状态；无法评估 ≠ 有漂移。
      echo "  ⚠ 本机没有运行区（verify-deploy exit 3）——部署一致性门禁只在有运行区的机器上生效"
      echo "    干净克隆 / 换机 / CI 里这是预期状态；本机有运行区时再跑一次即可验证。"
      ;;
    4)
      # 清单损坏 = 基线读不懂。**不许**与 3 混为一谈（那正是本轮缺陷：fail-open）。
      echo "  ✖ 部署清单损坏/形状不对（verify-deploy exit 4）"
      echo "    损坏 ≠ 没有运行区：这是 fail-closed 情形，禁止用\"删掉清单\"让门禁变绿。"
      echo "    恢复：走一次正规部署重建基线（build-release.ps1 → deploy.ps1）。"
      exit 1
      ;;
    5)
      echo "  ✖ 运行区尚无部署清单（verify-deploy exit 5）——无法证明运行区等于某个发布包"
      echo "    建基线只有一条路：build-release.ps1 → deploy.ps1（不要手工补清单）。"
      exit 1
      ;;
    *)
      echo "  ✖ 运行区被绕过 deploy.ps1 改动过 / 无法校验（verify-deploy exit $rc，详见上面清单）"
      echo "    正确链路：dev 改 → dev 测 → build-release.ps1 → deploy.ps1"
      exit 1
      ;;
  esac
fi

echo "[pre-commit] 全部通过"
exit 0
