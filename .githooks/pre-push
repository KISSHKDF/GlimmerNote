#!/bin/sh
# 拾光小册 · pre-push 门禁（真源：.githooks/pre-push）
#
# 拦住对 refs/heads/main 的**非快进推送**（含强推、含删分支）。
# 为什么必须有：CONTRIBUTING §四 写着"禁 push --force 到 main"，但 git 本地侧
# 没有任何默认保护；远端若没开保护分支，出错时是一次不可逆的历史改写。
# pre-push 是唯一能在"包发出去之前"拦住的关口。
#
# 判据：远端已存在的 main 提交必须是本地待推提交的祖先（git merge-base --is-ancestor）。
#   - 远端 main 不存在（remote_sha 全 0）：首次推送，放行
#   - 本地删除 main（local_sha 全 0）：不认为是快进，拦下
#   - 其余情况：祖先关系不成立即非快进，拦下
#
# 逃生阀：git push --no-verify（仅在确有必要时人工执行，务必留痕）
set -eu

ZERO=0000000000000000000000000000000000000000
failed=0
checked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${remote_ref:-}" ] || continue
  case "$remote_ref" in
    refs/heads/main) ;;
    *) continue ;;
  esac
  checked=$((checked + 1))

  if [ "$local_sha" = "$ZERO" ]; then
    echo "[pre-push] ✖ 拒绝删除远端 refs/heads/main（$local_ref）" >&2
    failed=1
    continue
  fi

  if [ "$remote_sha" = "$ZERO" ]; then
    echo "[pre-push] ✔ 远端尚无 refs/heads/main（首次推送），放行 $local_sha"
    continue
  fi

  if git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "[pre-push] ✔ 快进推送，放行 $remote_sha..$local_sha"
  else
    echo "[pre-push] ✖ 拒绝对 refs/heads/main 的非快进推送" >&2
    echo "           远端 $remote_sha 不是本地 $local_sha 的祖先。" >&2
    echo "           CONTRIBUTING §四：禁止 push --force 到 main；要撤销请用 git revert。" >&2
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "[pre-push] ✖ 推送被拒（见上）" >&2
  exit 1
fi

if [ "$checked" -eq 0 ]; then
  # git 只把"它打算更新的引用"交给 pre-push。普通的非快进推送（没加 --force）会在
  # 调用钩子之前就被 git 自己判成 non-fast-forward ⇒ 这里收到 0 行。
  # 此时不该打印"检查通过"——那会让人以为钩子放过了一次强推。
  echo "[pre-push] 本钩子未收到待检引用（git 侧已判为拒绝/无更新；加 --force 的强推才会送到这里）"
  exit 0
fi

echo "[pre-push] ✔ 检查通过（$checked 个引用）"
exit 0
